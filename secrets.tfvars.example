# Copy this file to secrets.tfvars and replace every REPLACE_ME value.
# Keep secrets.tfvars local; only this example file should be committed.

aws_profile = "boring-tech"
region      = "us-east-1"

mongodb_uri   = "mongodb+srv://REPLACE_ME"
account_alias = "REPLACE_ME"
base_url      = "https://api.cryptlex.com/v3"

stripe_secret_key_dev       = "sk_test_REPLACE_ME"
stripe_secret_key_prod      = "sk_live_REPLACE_ME"
webhook_signing_secret_dev  = "whsec_REPLACE_ME"
webhook_signing_secret_prod = "whsec_REPLACE_ME"
stripe_price_cents          = 2999
stripe_product_id           = "prod_REPLACE_ME"
dev_basic_auth_password     = "REPLACE_ME_USE_A_UNIQUE_PASSWORD"

openai_api_key        = "REPLACE_ME"
sam_api_key           = "REPLACE_ME"
brave_search_api_key  = "REPLACE_ME"
opportunity_email_to  = "you@example.com"
opportunity_email_from = "verified-ses-sender@example.com"

opportunity_minimum_score = 70
opportunity_lookback_days = 7
opportunity_schedule     = "rate(1 day)"
opportunity_openai_model = "gpt-4o-mini"
opportunity_max_ai_candidates_per_company = 20
opportunity_include_possible_matches      = false
